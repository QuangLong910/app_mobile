<?xml version="1.0" encoding="utf-8"?>
<!--
  Bản release chỉ mở cleartext (HTTP thường) cho đúng các địa chỉ khai ở đây — khác bản
  debug (src/debug/res/xml, mở hết). Đổi baseUrl trong local.properties là PHẢI thêm địa
  chỉ mới vào đây rồi build lại, không thì bản release cài máy khác gọi API sẽ không được,
  dù bản debug vẫn chạy bình thường nên dễ tưởng nhầm là mạng có vấn đề.

  Đang khai cả Tailscale (dùng được từ bất kỳ mạng nào, miễn máy cài app cũng có Tailscale
  và cùng tailnet) lẫn IP LAN hiện tại (chỉ dùng được khi cùng WiFi với máy chạy backend).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Qua cáp: adb reverse tcp:5160 tcp:5160 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Giả lập Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Tailnet của nhóm (tail82d659): mọi tên máy dạng <ten>.tail82d659.ts.net -->
        <domain includeSubdomains="true">ts.net</domain>
        <!-- IP Tailscale cố định của máy Long — đang là baseUrl mặc định -->
        <domain includeSubdomains="false">100.86.242.10</domain>
        <!-- IP LAN hiện tại của máy Long. Đổi mạng là đổi số này, xem local.properties -->
        <domain includeSubdomains="false">192.168.0.105</domain>
    </domain-config>
</network-security-config>
